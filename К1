def sum_of_negatives_between_max_min(arr):
    if not arr:  # Проверяем, что массив не пустой
        return 0

    max_index = arr.index(max(arr))
    min_index = arr.index(min(arr))

    # Находим границы между max и min
    start = min(max_index, min_index) + 1
    end = max(max_index, min_index)

    # Суммируем отрицательные элементы
    negative_sum = sum(x for x in arr[start:end] if x < 0)

    return negative_sum

# Пример использования
A = [3, -1, -4, 2, -2, 6, -3, 8, 0]
result = sum_of_negatives_between_max_min(A)
print("Сумма отрицательных элементов между max и min:", result)
